generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Required Tables ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Payment Fields
  plan           String    @default("free") // free | base | pro
  planExpiresAt  DateTime?
  subscriptionId String? // DodoPayments subscription_id for cancellation
  payments       Payment[]

  accounts Account[]
  sessions Session[]
  sites    Site[]
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

model Payment {
  id        String   @id
  amount    Int // In lowest denomination
  currency  String
  status    String // succeeded | failed | pending
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Site {
  id           String   @id // This will be the jobId
  userId       String
  slug         String?  @unique // Custom URL chosen by user
  url          String // The original Google Maps URL
  businessName String?
  status       String   @default("QUEUED") // QUEUED | COMPLETED | FAILED
  createdAt    DateTime @default(now())

  // Store the full generated site data and config as JSON
  businessData Json?
  config       Json?
  deleted      Boolean @default(false)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  members      GymMember[]
  gymSettings  GymSettings?
  gymPayments  GymPayment[]
  workoutPlans GymWorkoutPlan[]
  dietPlans    GymDietPlan[]
  gymLeads     GymLead[]
}

model GymMember {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String

  membershipPlanId String
  membershipTitle  String
  membershipPrice  String
  durationMonths   Int    @default(1)
  pricePerMonth    Int    @default(0)

  startDate DateTime
  endDate   DateTime
  status    String   @default("active") // active | expired

  // Notification flags — reset on each renewal
  notifiedEnroll  Boolean @default(false)
  notified7Days   Boolean @default(false)
  notified1Day    Boolean @default(false)
  notifiedExpired Boolean @default(false)

  createdAt DateTime @default(now())

  assignedPlanId     String?
  assignedPlan       GymWorkoutPlan? @relation(fields: [assignedPlanId], references: [id], onDelete: SetNull)
  assignedDietPlanId String?
  assignedDietPlan   GymDietPlan?    @relation(fields: [assignedDietPlanId], references: [id], onDelete: SetNull)
  payments           GymPayment[]

  @@index([siteId])
  @@index([endDate])
}

model GymWorkoutPlan {
  id        String      @id @default(cuid())
  siteId    String
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  notes     String?
  sessions  Json        @default("[]")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  members   GymMember[]

  @@index([siteId])
}

model GymDietPlan {
  id            String      @id @default(cuid())
  siteId        String
  site          Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name          String
  goal          String?
  notes         String?
  totalCalories Int         @default(0)
  protein       Int         @default(0)
  carbs         Int         @default(0)
  fat           Int         @default(0)
  meals         Json        @default("[]")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  members       GymMember[]

  @@index([siteId])
}

model GymSettings {
  id     String @id @default(cuid())
  siteId String @unique
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  gstin          String?
  businessName   String?
  address        String?
  state          String?
  isComposition  Boolean @default(false)
  invoicePrefix  String  @default("INV")
  invoiceCounter Int     @default(0)
  currentFY      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OnboardingLead {
  id        String   @id @default(cuid())
  gymName   String
  mapsUrl   String?
  step      String // hero | maps_selected | maps_skipped | preview_viewed | login_prompted | login_success | phone_entered | email_entered
  phone     String?
  email     String?
  sessionId String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([gymName])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
}

model GymPayment {
  id       String    @id @default(cuid())
  siteId   String
  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  memberId String
  member   GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  invoiceNumber String
  invoiceDate   DateTime @default(now())
  financialYear String

  memberName     String
  memberPhone    String
  memberEmail    String?
  planTitle      String
  durationMonths Int

  taxableAmount Float
  cgst          Float
  sgst          Float
  igst          Float
  totalAmount   Float
  isInterstate  Boolean @default(false)

  type String @default("enrollment") // enrollment | renewal

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([financialYear])
  @@index([memberId])
}

model GymLead {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  email   String?
  message String?
  source  String  @default("Website") // Website | WhatsApp | Walk-in | Referral
  status  String  @default("new") // new | contacted | converted

  enquiryDate DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([siteId])
  @@index([createdAt])
}
