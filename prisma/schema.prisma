generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Required Tables ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Payment Fields
  plan          String    @default("base") // base | pro | lifetime
  isLifetime    Boolean   @default(false)
  payments      Payment[]

  accounts Account[]
  sessions Session[]
  sites    Site[]
}

model Payment {
  id            String   @id
  amount        Int      // In lowest denomination
  currency      String
  status        String   // succeeded | failed | pending
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Site {
  id           String   @id  // This will be the jobId
  userId       String
  slug         String?  @unique // Custom URL chosen by user
  url          String           // The original Google Maps URL
  businessName String?
  status       String   @default("QUEUED") // QUEUED | COMPLETED | FAILED
  createdAt    DateTime @default(now())

  // Store the full generated site data and config as JSON
  businessData Json?
  config       Json?
  deleted      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
